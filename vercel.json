{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "app.js": {
      "includeFiles": "nmd/naija-market-day/{server/**,app/**,assets/**,*.html}",
      "maxDuration": 30
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/app.js" }
  ]
}
